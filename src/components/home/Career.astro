---
import { getCollection } from 'astro:content';
import { jobs } from '../../data/career';
import { newTab, site } from '../../data/site';
import DeckHead from '../DeckHead.astro';

const published = new Set(
  (await getCollection('breakdowns', ({ data }) => import.meta.env.DEV || !data.draft)).map((b) => b.id),
);
---

<section class="sec" id="experience" style="--deck:var(--q-epic)" aria-labelledby="experience-title">
  <DeckHead icon="d-badge" title="Experience" headingId="experience-title">
    One line a role here. My{' '}
    <a href={site.resume.href} {...newTab(site.resume.href)}>
      résumé (PDF)
    </a>{' '}
    has the details.
  </DeckHead>
  <div class="ledger">
    {jobs.map((job) => (
      <div class="job">
        <div class="when">
          {job.ref} · {job.when}
        </div>
        <div>
          <h3>{job.title}</h3>
          <div class="org">{job.org}</div>
          {job.summary && <p class="job-sum">{job.summary}</p>}
          {job.breakdown && published.has(job.breakdown) && (
            <a class="job-link" href={`/breakdowns/${job.breakdown}`}>
              Read the breakdown
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
