---
/** One inline SVG sprite for every glyph on the site; reference with <use href="#id" />. */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <!-- brand: a faceted Akita head, for Chuken (忠犬, loyal dog). The mask takes currentColor; the white face
       (urajiro) and brows take --mark-face, and the eyes and nose --mark-ink. public/favicon.svg draws the same head. -->
  <symbol id="g-mark" viewBox="0 -0.75 64 64">
    <path
      d="M14 6L25 15L32 14L39 15L50 6L55 20L60 30L61 38L54 48L40 56.5H24L10 48L3 38L4 30L9 20Z"
      style="fill:var(--mark-face,#EDEAE3)"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linejoin="round"
    ></path>
    <path d="M32 41H35L37.5 35L46 37L60.7 34.5L61 38L54 48L40 56.5H32Z" fill="#000" opacity=".07"></path>
    <path
      d="M14 6L25 15L32 14L39 15L50 6L55 20L60 30L60.7 34.5L46 37L37.5 35L35 41H29L26.5 35L18 37L3.3 34.5L4 30L9 20Z"
      fill="currentColor"
    ></path>
    <path d="M32 14L39 15L50 6L55 20L60 30L60.7 34.5L46 37L37.5 35L35 41H32Z" fill="#000" opacity=".2"></path>
    <path d="M14.6 10.5L22.5 15.6L11 19.5ZM49.4 10.5L41.5 15.6L53 19.5Z" fill="#000" opacity=".3"></path>
    <path
      d="M16.5 24.5L21 22.2L26 23.8L21 25.9ZM47.5 24.5L43 22.2L38 23.8L43 25.9Z"
      style="fill:var(--mark-face,#EDEAE3)"
    ></path>
    <path
      d="M16 29.2L26 31.2L20.5 33.8ZM48 29.2L38 31.2L43.5 33.8ZM26.5 40.5H37.5L34.5 46H29.5Z"
      style="fill:var(--mark-ink,#08080A)"
    ></path>
  </symbol>

  <!-- damage schools -->
  <symbol id="g-physical" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M5 5l14 14M19 5L5 19"></path>
    <circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol id="g-fire" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 2.5c1.6 3.6 5.2 5.8 5.2 10.4A5.2 5.2 0 0 1 6.8 12.9c0-2 .8-3.7 2-5.1.3 1.7 1.2 2.8 2.5 3.3-.1-2.6.1-5.3.7-8.6z"></path>
  </symbol>
  <symbol id="g-frost" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M12 2.5v19M3.8 7.25l16.4 9.5M3.8 16.75l16.4-9.5"></path>
  </symbol>
  <symbol
    id="g-nature"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linejoin="round"
    stroke-linecap="round"
  >
    <path d="M4.5 19.5C4.5 9.5 10.5 5 19.5 5c0 9-4.5 14.5-15 14.5z"></path>
    <path d="M4.5 19.5c3-5.5 6.5-9 11-11.5"></path>
  </symbol>
  <symbol id="g-holy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"></path>
  </symbol>
  <symbol id="g-arcane" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="12" cy="12" r="8.5"></circle>
    <ellipse cx="12" cy="12" rx="8.5" ry="3" transform="rotate(-30 12 12)"></ellipse>
    <circle cx="12" cy="12" r="2.6" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol id="g-shadow" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 3A9 9 0 0 0 12 21A9.9 9.9 0 0 1 12 3z"></path>
  </symbol>

  <!-- decks and action bar -->
  <symbol
    id="d-console"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linejoin="round"
    stroke-linecap="round"
  >
    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
    <path d="M7 9l3 3-3 3M12.5 15H17"></path>
  </symbol>
  <symbol id="d-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"></path>
  </symbol>
  <symbol id="d-sword" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <path d="M18 3l3 3-9 9-3-3z"></path>
    <path d="M9 12l-6 6 3 3 6-6M6 18l-2 2"></path>
  </symbol>
  <symbol id="d-pad" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <rect x="2" y="7" width="20" height="11" rx="4"></rect>
    <path d="M7 10v5M4.5 12.5h5"></path>
    <circle cx="16" cy="11.5" r="1"></circle>
    <circle cx="18.5" cy="14" r="1"></circle>
  </symbol>
  <symbol id="d-badge" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <circle cx="12" cy="9" r="6"></circle>
    <path d="M8 14l-2 7 6-3 6 3-2-7"></path>
  </symbol>
  <symbol
    id="d-wrench"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linejoin="round"
  >
    <path d="M15 3a6 6 0 0 0-5.3 8.8L3 18.5 5.5 21l6.7-6.7A6 6 0 1 0 15 3z"></path>
  </symbol>
  <symbol id="d-star" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <path d="M12 3l2.7 5.8 6.3.8-4.6 4.4 1.2 6.2L12 17.3 6.4 20.2l1.2-6.2L3 9.6l6.3-.8z"></path>
  </symbol>
  <symbol
    id="d-quill"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linejoin="round"
    stroke-linecap="round"
  >
    <path d="M20 3.5C13 4 8 8.5 6.5 15.5L5 20l3.2-2.4C15 16 19.3 10.5 20 3.5z"></path>
    <path d="M5 20l7.5-7.5M9.5 12.5h4"></path>
  </symbol>
  <symbol id="d-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
    <path d="M3 7l9 6 9-6"></path>
  </symbol>

  <!-- off the clock -->
  <symbol id="i-mat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="9" cy="12" r="5.5"></circle>
    <circle cx="15" cy="12" r="5.5"></circle>
  </symbol>
  <symbol id="i-ball" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3v18M5.7 5.7c3.2 3.4 3.2 9.2 0 12.6M18.3 5.7c-3.2 3.4-3.2 9.2 0 12.6"></path>
  </symbol>
  <symbol
    id="i-sword"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M4 4l10 10M4 4h3.5L15 11.5M4 4v3.5L11.5 15"></path>
    <path d="M20 4L10 14M20 4h-3.5L12 8.5M20 4v3.5L15.5 12"></path>
    <path d="M13 16l5 5M16 13l5 5M11 16l-5 5M8 13l-5 5"></path>
  </symbol>
  <symbol id="i-crown" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <path d="M4 18h16M4 18L3 8l5 4 4-7 4 7 5-4-1 10z"></path>
  </symbol>
  <symbol
    id="i-scroll"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linejoin="round"
    stroke-linecap="round"
  >
    <path d="M7 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H8"></path>
    <path d="M7 4a2 2 0 0 0-2 2v2h4V6a2 2 0 0 0-2-2zM8 20a2 2 0 0 1-2-2V8"></path>
    <path d="M11 9h5M11 12h5M11 15h3"></path>
  </symbol>
  <symbol id="i-book" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <path d="M3 5h6a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H3zM21 5h-6a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h7z"></path>
  </symbol>
  <symbol
    id="i-compass"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M15.5 8.5l-2 5-5 2 2-5z"></path>
    <circle cx="12" cy="12" r=".9" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol
    id="i-pot"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M4 11h16v3a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6zM2 11h20"></path>
    <path d="M9 7c0-2 2-2 2-4M13 7c0-2 2-2 2-4"></path>
  </symbol>
  <symbol id="i-knight" viewBox="0 0 24 24" fill="currentColor">
    <path d="M6 21.5h12.5v-2H6z"></path>
    <path d="M7.4 18.5h10.3c.2-3.4-.6-6.3-1.6-8.7-1-2.4-2.9-4.3-5.4-4.9L9.8 3 8.6 5.4C6.8 6.5 5.5 8.5 5 10.9l1.2 1.7 2.8-.9 1.9-1.6c.5 1.5 0 2.9-1.2 4.1-1.4 1.4-2.3 2.6-2.3 4.3z"></path>
    <circle cx="9.6" cy="8.1" r=".9" fill="#1F1505"></circle>
  </symbol>
  <symbol
    id="i-speech"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linejoin="round"
  >
    <path d="M3 4h11v8H8l-3 3v-3H3z"></path>
    <path d="M14 8h7v8h-2v3l-3-3h-5v-4"></path>
  </symbol>
  <symbol id="i-paw" viewBox="0 0 24 24" fill="currentColor">
    <ellipse cx="12" cy="15.5" rx="4.2" ry="3.6"></ellipse>
    <circle cx="6.3" cy="10.5" r="1.9"></circle>
    <circle cx="9.8" cy="6.8" r="1.9"></circle>
    <circle cx="14.2" cy="6.8" r="1.9"></circle>
    <circle cx="17.7" cy="10.5" r="1.9"></circle>
  </symbol>

  <!-- forge seal -->
  <symbol id="i-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
    <rect x="5" y="11" width="14" height="10" rx="2"></rect>
    <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
    <circle cx="12" cy="16" r="1.4" fill="currentColor" stroke="none"></circle>
  </symbol>
</svg>
