---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { categoryTitle } from '../../data/blog';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
---

<BaseLayout title={`${post.data.title} | ${site.name}`} description={post.data.description}>
  <main id="main" class="wrap page">
    <article class="post">
      <header class="page-head">
        <div class="crumb">
          <a href="/">Home</a> / <a href="/blog">Blog</a> /{' '}
          <a href={`/blog#${post.data.category}`}>{categoryTitle(post.data.category)}</a>
        </div>
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
          {post.data.updatedDate && <span>Updated {fmt.format(post.data.updatedDate)}</span>}
          <span>{minutes} min read</span>
          {post.data.draft && <span class="draft-tag">draft</span>}
        </div>
        {post.data.tags.length > 0 && (
          <div class="tags post-tags">
            {post.data.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )}
      </header>
      <div class="post-body">
        <Content />
      </div>
    </article>
    <p style="margin-top:40px">
      <a class="btn" href="/blog">
        Back to the blog
      </a>
    </p>
    <Footer />
  </main>
</BaseLayout>

<script>
  import { opensNewTab } from '../../data/site';
  // Post bodies follow the site-wide rule: other sites and files open in a new tab.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.post-body a[href]')) {
    if (opensNewTab(a.getAttribute('href') ?? '')) Object.assign(a, { target: '_blank', rel: 'noopener' });
  }
</script>
